# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/destiny

# Embedding model — 必須與 knowledge_atoms.embedding vector(N) 維度一致
# text-embedding-3-small = 1536 維（schema 預設）
# text-embedding-3-large = 3072 維（需 migration 調整向量維度）
OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Generation (Anthropic — 讀取 ANTHROPIC_API_KEY 環境變數)
ANTHROPIC_API_KEY=sk-ant-...
CHAT_MODEL=claude-sonnet-4-6
